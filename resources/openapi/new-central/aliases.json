                    "Alias"
                ],
                "parameters": [
                    {
                        "in": "query",
                        "name": "view-type",
                        "required": false,
                        "description": "LIBRARY or LOCAL.",
                        "schema": {
                            "type": "string",
                            "default": "LIBRARY"
                        }
                    },
                    {
                        "in": "query",
                        "name": "object-type",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "scope-id",
                        "required": false,
